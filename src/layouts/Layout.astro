---
const { title = "Fehlstart" } = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Geist+Mono:wght@500&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav class="navbar">
			<div class="nav-container">
				<a href="/" class="logo">Fehlstart Apps</a>
				<ul class="nav-links">
					<li class="nav-item dropdown">
						<a href="#apps" class="nav-link">Apps</a>
						<ul class="dropdown-menu" aria-label="Apps">
							<li><a href="/leftoverlens">LeftoverLens</a></li>
							<li><a href="/sackheld">SackHeld</a></li>
							<li><a href="/sleepsync">SleepSync</a></li>
							<li><a href="/focuzzz">Focuzzz</a></li>
						</ul>
					</li>
					<li><a href="#support" class="btn-support">Unterstütze mich</a></li>
				</ul>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer class="footer">
			<div class="footer-content">
				<p>&copy; 2026 Fehlstart Apps. Crafted with ❤️ in Switzerland.</p>
				<div class="footer-links">
					<!--<a href="https://twitter.com" target="_blank" rel="noopener">Twitter</a>-->
					<!--<a href="https://github.com" target="_blank" rel="noopener">GitHub</a>-->
					<a href="mailto:fehlstartapps@gmail.com">Email</a>
				</div>
			</div>
		</footer>

		<script>
			// Toggle dropdown on click while preserving hover behavior
			(() => {
				const navItem = document.querySelector('.nav-item.dropdown');
				if (!navItem) return;
				const trigger = navItem.querySelector('.nav-link');

				// Toggle 'open' class on click (keeps menu visible)
				trigger.addEventListener('click', (ev) => {
					// allow default anchor behavior (scroll to #apps) but toggle menu too
					navItem.classList.toggle('open');
				});

				// Close when clicking outside
				document.addEventListener('click', (ev) => {
					if (!navItem.classList.contains('open')) return;
					if (!navItem.contains(ev.target)) {
						navItem.classList.remove('open');
					}
				});

				// Close on Escape for accessibility
				document.addEventListener('keydown', (ev) => {
					if (ev.key === 'Escape') navItem.classList.remove('open');
				});
			})();
		</script>

	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html,
	body {
		width: 100%;
		height: 100%;
		background-color: #0a0e27;
		color: #e5e7eb;
		font-family: 'Inter', sans-serif;
		line-height: 1.6;
	}

	a {
		color: #60a5fa;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	a:hover {
		color: #93c5fd;
	}

	/* Navbar */
	.navbar {
		position: sticky;
		top: 0;
		background: rgba(10, 14, 39, 0.95);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(96, 165, 250, 0.1);
		z-index: 100;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		font-size: 1.5rem;
		font-weight: 800;
		background: linear-gradient(135deg, #60a5fa, #a78bfa);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		transition: transform 0.3s ease;
	}

	.logo:hover {
		transform: scale(1.05);
	}

	.nav-links {
		list-style: none;
		display: flex;
		gap: 2rem;
		align-items: center;
	}

	.nav-links a {
		font-weight: 500;
		transition: color 0.3s ease;
	}

	/* Dropdown menu for Apps */
	.nav-item {
		position: relative;
	}

	.dropdown-menu {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		min-width: 200px;
		background: linear-gradient(180deg, rgba(15,23,42,0.98), rgba(20,25,50,0.98));
		border: 1px solid rgba(96,165,250,0.08);
		backdrop-filter: blur(8px);
		padding: 0.5rem;
		border-radius: 10px;
		box-shadow: 0 8px 30px rgba(2,6,23,0.6);
		list-style: none;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
		z-index: 120;
	}

	.dropdown-menu li {
		padding: 0.25rem 0.5rem;
	}

	.dropdown-menu a {
		display: block;
		padding: 0.45rem 0.75rem;
		color: #e5e7eb;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.18s ease, color 0.18s ease;
	}

	.dropdown-menu a:hover,
	.dropdown-menu a:focus {
		background: rgba(96,165,250,0.07);
		color: #93c5fd;
	}

	/* Show on hover or keyboard focus */
	.nav-item:hover .dropdown-menu,
	.nav-item:focus-within .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	/* Also show when toggled via click (keeps dropdown open after click) */
	.nav-item.open .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.btn-support {
		background: linear-gradient(135deg, #60a5fa, #a78bfa);
		color: white !important;
		padding: 0.5rem 1.5rem;
		border-radius: 8px;
		font-weight: 600;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.btn-support:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(96, 165, 250, 0.3);
		color: white !important;
	}

	/* Main*/
	main {
	flex: 1;
	}

	/* Footer */
	.footer {
		margin-top: 6rem;
		border-top: 1px solid rgba(96, 165, 250, 0.1);
		background: linear-gradient(180deg, transparent, rgba(96, 165, 250, 0.05));
		padding: 3rem 2rem;
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		text-align: center;
	}

	.footer-content p {
		color: #9ca3af;
		margin-bottom: 1rem;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		gap: 2rem;
	}

	.footer-links a {
		color: #9ca3af;
		transition: color 0.3s ease;
	}

	.footer-links a:hover {
		color: #60a5fa;
	}
</style>
