---
const { title, description, link, icon } = Astro.props;
const isImage = typeof icon === 'object';
---

<a class="card" href={link} aria-label={`Zur App ${title}`}>
  <div class="icon">
    {isImage ? (
      <img src={icon.src} alt={title} class="icon-img" />
    ) : (
      <span>{icon}</span>
    )}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
  .card {
    display: block;
    background: linear-gradient(135deg, rgba(30, 41, 82, 0.8), rgba(55, 48, 163, 0.4));
    border: 1px solid rgba(96, 165, 250, 0.2);
    padding: 1.25rem 1rem;
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    backdrop-filter: blur(10px);
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(96, 165, 250, 0.1), rgba(167, 139, 250, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: rgba(96, 165, 250, 0.5);
    box-shadow: 0 12px 30px rgba(96, 165, 250, 0.15);
  }

  .card:hover::before {
    opacity: 1;
  }

  .icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    display: flex;
    transition: transform 0.2s ease;
    height: 56px;
    align-items: center;
    justify-content: center;
  }

  .icon-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .card:hover .icon {
    transform: scale(1.2) rotate(10deg);
  }

  .card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: #e5e7eb;
  }

  .card p {
    color: #d1d5db;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Removed per-request: inline 'Mehr erfahren' button and styles */
</style>