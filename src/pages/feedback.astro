---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Feedback — Fehlstart Apps">
  <section class="feedback-section">
    <div class="container">
      <h1>Feedback</h1>
      <p>Schreib mir gern dein Feedback, Fehlerberichte oder Verbesserungsvorschläge.</p>

      <form id="feedbackForm">
        <label for="name">Name
          <input type="text" id="name" name="name" required />
        </label>

        <label for="email">E‑Mail
          <input type="email" id="email" name="email" required />
        </label>

        <label for="message">Nachricht
          <textarea id="message" name="message" rows="6" required></textarea>
        </label>

        <div class="actions">
          <button type="submit" class="btn-primary">Absenden</button>
          <button type="reset" class="btn-secondary">Zurücksetzen</button>
        </div>

        <p id="formMessage" class="form-message" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('feedbackForm');
  const msg = document.getElementById('formMessage');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const message = document.getElementById('message').value.trim();
    if (!name || !email || !message) {
      msg.textContent = 'Bitte fülle alle Felder aus.';
      return;
    }

    const subject = encodeURIComponent(`Feedback von ${name}`);
    const body = encodeURIComponent(`Name: ${name}\nE‑Mail: ${email}\n\nNachricht:\n${message}`);

    // Versuche, den Standard-E‑Mail-Client zu öffnen
    window.location.href = `mailto:fehlstartapps@gmail.com?subject=${subject}&body=${body}`;
    msg.textContent = 'Dein E‑Mail-Client wurde geöffnet. Alternativ: fehlstartapps@gmail.com';
  });
});
</script>

<style>
.feedback-section { padding: 4rem 2rem; max-width: 800px; margin: 0 auto; }
.container h1 { font-size:2rem; margin-bottom:0.5rem; background: linear-gradient(135deg,#60a5fa,#a78bfa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
.container p { color:#9ca3af; margin-bottom:1.5rem; }
form { background: linear-gradient(180deg, rgba(15,23,42,0.6), rgba(20,25,50,0.6)); padding:1.5rem; border-radius:12px; border:1px solid rgba(96,165,250,0.06); }
label { display:block; font-weight:600; margin-bottom:0.75rem; color:#e5e7eb; }
input[type="text"], input[type="email"], textarea { width:100%; padding:0.75rem; border-radius:8px; background:transparent; border:1px solid rgba(255,255,255,0.06); color:#e5e7eb; margin-top:0.25rem; margin-bottom:1rem; }
.actions { display:flex; gap:1rem; align-items:center; }
.btn-primary { background: linear-gradient(135deg,#60a5fa,#a78bfa); color:white; padding:0.75rem 1.25rem; border-radius:8px; font-weight:700; border:none; cursor:pointer; }
.btn-secondary { background: rgba(96,165,250,0.08); color:#60a5fa; padding:0.6rem 1rem; border-radius:8px; border:1px solid rgba(96,165,250,0.12); cursor:pointer; }
.form-message { margin-top:1rem; color:#9ca3af; font-size:0.95rem; }
@media (max-width:768px) { .actions { flex-direction:column; } .actions button { width:100%; } }
</style>
