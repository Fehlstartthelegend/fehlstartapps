---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
---

<Layout title="Fehlstart the legend - App Developer">
  <main>
    <h1>Meine Apps</h1>
    
    <div class="grid">
      <AppCard 
        title="LeftoverLens" 
        description="KI-Rezepte aus deinen Resten." 
        link="#" 
        icon="📸"
      />
      <AppCard 
        title="SackHeld" 
        description="Sparziele spielend leicht verwalten." 
        link="#" 
        icon="🗑️"
      />
      <AppCard 
        title="SleepSync" 
        description="Optimiere deinen Schlafzyklus." 
        link="#" 
        icon="💤"
      />
	  <AppCard 
        title="Focuzzz" 
        description="Dein Fokus-Timer für maximale Produktivität." 
        link="#" 
        icon="⏱️"
      />
    </div>

    <section class="coffee">
      <h2>Unterstütze meine Arbeit</h2>
      <a href="https://www.buymeacoffee.com/fehlstartapps" target="_blank">
        <img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me A Coffee" style="height: 60px !important;width: 217px !important;" >
      </a>
    </section>
  </main>
</Layout>

<style>
	main {
    margin: auto;
    padding: 4rem 2rem;
    max-width: 1000px;
    font-family: 'Inter', sans-serif;
    color: #fff;
    background-color: #0f172a; /* Ein schickes Dunkelblau/Schwarz */
}

h1 {
    font-size: 3rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 3rem;
    background: linear-gradient(to right, #38bdf8, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 5rem;
}
  main { margin: auto; padding: 2rem; max-width: 800px; color: #333; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .coffee { margin-top: 4rem; text-align: center; }
</style>